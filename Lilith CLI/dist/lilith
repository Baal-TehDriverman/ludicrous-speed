        tiers: ["medium", "large"],
        contextWindow: 128e3,
        size: "Cloud",
        quantization: "Various",
        local: false,
        provider: "Cloud",
        capabilities: ["reasoning", "coding"]
      };
    }
    return {
      name: modelName,
      description: "Unknown model",
      tiers: ["medium"],
      contextWindow: 8192,
      size: "Unknown",
      quantization: "Unknown",
      local: false,
      provider: "Unknown",
      capabilities: []
